{
  "opencollection": "1.0.0",
  "info": {
    "name": "AccuWeather One Active Storms Raine API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Raine",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "AccuWeather Retreives the Raine Configuration for a Page",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dataservice.accuweather.com/api/raine",
            "params": [
              {
                "name": "Locale",
                "value": "en-us",
                "type": "query",
                "description": "ISO 639-2 and ISO 3166-1 code for the locale"
              },
              {
                "name": "MeasurementDisplay",
                "value": "Imperial",
                "type": "query",
                "description": "Display type for weather conditions and distance"
              },
              {
                "name": "WindUnit",
                "value": "Cardinal",
                "type": "query",
                "description": "Additional display type for wind direction"
              },
              {
                "name": "Theme",
                "value": "System",
                "type": "query",
                "description": "Theme for the application"
              },
              {
                "name": "pageGroup",
                "value": "example-value",
                "type": "query",
                "description": "The page group name."
              },
              {
                "name": "platform",
                "value": "example-value",
                "type": "query",
                "description": "The platform name."
              },
              {
                "name": "locationKey",
                "value": "347628",
                "type": "query",
                "description": "The location key to retrieve weather location."
              }
            ]
          },
          "docs": "AccuWeather Retreives the Raine Configuration for a Page"
        }
      ]
    }
  ],
  "bundled": true
}